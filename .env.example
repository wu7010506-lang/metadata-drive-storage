# Absolute or relative path to a Service Account JSON file. Never commit it.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Share this Drive folder with the Service Account email before probing.
GOOGLE_DRIVE_FOLDER_ID=

# Probe defaults (all payloads are ASCII, so bytes == characters).
METADATA_BACKEND=appProperties
PROBE_INITIAL_BYTES=100
PROBE_MAX_BYTES=1048576
PROBE_SAFE_MARGIN_PERCENT=15
# Set this to the recommended safe payload reported by a successful name probe.
NAME_SAFE_PAYLOAD_BYTES=0
DESCRIPTION_SAFE_PAYLOAD_BYTES=0
UPLOAD_BACKEND=name
# base64url is the stable default. combined/Base85 are opt-in experiments,
# not proven upload speedups; combined needs both measured field capacities.
STORAGE_ENCODING=base64url
UPLOAD_WORKERS=16
# Supported upload range is 1..128. Test higher worker counts before selecting them;
# additional workers can increase latency or quota backoff instead of throughput.
# 1 = individual calls. With batches, UPLOAD_WORKERS is concurrent batches.
# Enable a larger batch only after benchmarking it in your environment.
UPLOAD_BATCH_SIZE=1
# Experimental shared inner-request pacing; 0 keeps the measured fixed profile.
# 11400 = 95% of a confirmed legacy 12000 requests/min quota; NOT quota units.
# A ceiling, not guaranteed utilization. Test after current uploads finish.
UPLOAD_TARGET_REQUESTS_PER_MINUTE=0
DOWNLOAD_WORKERS=1
GOOGLE_API_MAX_ATTEMPTS=5
# HTTP socket inactivity timeout, not a whole-job deadline. Allowed 5..120.
# Keep 60 until a paired benchmark justifies a lower value.
GOOGLE_API_HTTP_TIMEOUT_SECONDS=60
GOOGLE_API_INITIAL_DELAY_SECONDS=1
GOOGLE_API_MAX_DELAY_SECONDS=16
GOOGLE_API_MIN_INTERVAL_SECONDS=0.1
SQLITE_PATH=data/metadata-drive.db
# Actual input-file MiB; maximum 10240 (10 GiB). Multipart headers are separate.
UI_MAX_UPLOAD_MB=10240
UPLOAD_TEMP_DIR=E:/metadata-drive-temp
LOG_LEVEL=INFO
DOWNLOAD_TEMP_DIR=E:/metadata-drive-temp
DOWNLOAD_OUTPUT_DIR=E:/metadata-drive-downloads
